# RUTIC Standalone Agent
#
# OpenClaw full 이미지를 베이스로 agent-entry.ts만 실행.
# dispatchInboundMessage가 OpenClaw 전체 런타임을 사용하므로
# 별도 경량 빌드 불가 — gateway와 동일 이미지, 다른 엔트리포인트.
#
# 환경 변수:
#   RUTIC_AGENT_ID             에이전트 ID (필수)
#   RUTIC_NATS_URL             NATS 서버 전체 URL (예: nats://oracle:4222)
#   RUTIC_NATS_TAILSCALE_HOST  Tailscale 호스트명만 입력 → URL 자동 조립 (예: oracle)
#                              RUTIC_NATS_URL 미설정 시 사용. MagicDNS 사용 환경 권장.
#   RUTIC_NATS_CREDS           NATS credentials 경로 (선택)
#   OPENCLAW_CONFIG            로컬 config 파일 경로 (없으면 gateway에서 수신)
#
# 빌드:
#   docker build -f Dockerfile.agent -t rutic-agent \
#     --build-arg OPENCLAW_IMAGE=openclaw:local .
#
# 실행:
#   docker run --rm \
#     -e RUTIC_AGENT_ID=my-agent \
#     -e RUTIC_NATS_TAILSCALE_HOST=oracle \
#     rutic-agent

ARG OPENCLAW_IMAGE=openclaw:local
FROM ${OPENCLAW_IMAGE}

# config 볼륨 마운트 포인트
VOLUME ["/config"]

# agent-entry.ts 엔트리포인트 (dist/는 openclaw:local 이미지 내 컴파일 결과)
CMD ["node", "dist/nats/agent-entry.js"]
